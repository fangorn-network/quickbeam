# audius-demo-large — local dev.
#
# Both URLs are RELATIVE so they ride the app's own origin through vite's proxy
# (see vite.config.ts). Naming them absolutely works on this machine and nowhere
# else: through a tunnel `localhost` is the visitor's machine, and an http:// call
# from an https:// page is blocked as mixed content regardless.
VITE_CDN_URL=/cdn
VITE_API_URL=/api

# The bootstrap graph downloaded whole at load (41,424 records).
VITE_DOMAIN=audius-home
# The domain whose CODEBOOK indexes the full 1.9M corpus behind the API. Differs from
# VITE_DOMAIN on purpose — the bootstrap is a slice, the codebook covers everything.
VITE_INDEX_DOMAIN=audius-large

# Cells probed per query. 1 ≈ 88% of achievable similarity at ~1.2 MB; 4 ≈ 93%.
VITE_NPROBE=1

VITE_PLATFORM_OWNER=0x1111111111111111111111111111111111111111
